{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alias Studio Code",
  "version": "0.1.0",
  "identifier": "com.alias.aliasstudiocode",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Alias Studio Code",
        "maximized": true,
        "decorations": false,
        "height": 700,
        "width": 950
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; media-src 'self' asset: https://asset.localhost;",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "C:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../licenses/"
    ],
    "fileAssociations": [
      {
        "ext": [
          "docx",
          "odt",
          "png",
          "jpg",
          "svg",
          "gif",
          "jpeg",
          "http",
          "txt",
          "js",
          "ts",
          "jsx",
          "tsx",
          "mjs",
          "cjs",
          "html",
          "htm",
          "css",
          "scss",
          "sass",
          "less",
          "json",
          "jsonc",
          "json5",
          "md",
          "mdx",
          "markdown",
          "py",
          "pyw",
          "rs",
          "java",
          "kt",
          "kts",
          "c",
          "cpp",
          "cc",
          "cxx",
          "h",
          "hpp",
          "cs",
          "go",
          "rb",
          "php",
          "swift",
          "xml",
          "xsl",
          "xslt",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "sh",
          "bash",
          "zsh",
          "fish",
          "bat",
          "cmd",
          "ps1",
          "sql",
          "lua",
          "r",
          "dart",
          "vue",
          "svelte",
          "graphql",
          "gql",
          "env",
          "gitignore",
          "editorconfig",
          "dockerfile",
          "m4a",
          "mp3",
          "mp4",
          "acc",
          "wav",
          "s",
          "dll",
          "lib"
        ],
        "name": "Cualquier Archivo",
        "description": "Abrir con mi editor de código",
        "role": "Editor",
        "mimeType": "*/*"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}